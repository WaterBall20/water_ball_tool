{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug tests 'water_ball_tool'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test"
        ]
      }
    },
    {
      "name": "Debug tests all",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--workspace",
          "--all-features",
          "--",
          "--include-ignored"
        ]
      }
    },
    {
      "name": "Debug 'water_ball_tool'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "--bin=water_ball_tool"
        ]
      }
    },
    {
      "name": "Debug 'water_ball_tool' mp",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "run",
          "--",
          "mp",
          "-v",
          "0.15",
          "-m",
          "periodic-shuffle",
          "D:\\WaterBall\\Music\\欧美"
        ]
      }
    },
    {
      "name": "Debug Release 'water_ball_tool' mp",
      "type": "lldb",
      "request": "launch",
      "env": {
        "LLDB_USE_NATIVE_PDB_READER": "yes"
      },
      "cargo": {
        "args": [
          "run",
          "--release",
          "--",
          "mp",
          "-v",
          "0.15",
          "-m",
          "periodic-shuffle",
          "D:\\WaterBall\\Music\\欧美"
        ]
      }
    }
  ]
}
